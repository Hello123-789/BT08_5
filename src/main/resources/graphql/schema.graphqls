type Query {
    # Trang chủ
    productsSortedByPriceAsc: [Product]
    productsByCategory(categoryId: ID!): [Product]
    
    # Category Queries
    categories: [Category]
    categoryById(id: ID!): Category
    categoriesPage(keyword: String, page: Int, size: Int): CategoryPage
    
    # Product Queries
    products: [Product]
    productById(id: ID!): Product
    productsPage(keyword: String, page: Int, size: Int): ProductPage
}

type Mutation {
    # Category Mutations
    createCategory(input: CategoryInput!): Category
    updateCategory(id: ID!, input: CategoryInput!): Category
    deleteCategory(id: ID!): Boolean
    
    # Product Mutations
    createProduct(input: ProductInput!): Product
    updateProduct(id: ID!, input: ProductInput!): Product
    deleteProduct(id: ID!): Boolean
}

type Category {
    categoryId: ID!
    categoryName: String!
    icon: String
    products: [Product]
}

type Product {
    id: ID!
    name: String!
    brand: String
    price: Float!
    quantity: Int!
    description: String
    createdAt: String
    category: Category
    images: [ProductImage]
}

type ProductImage {
    id: ID!
    imageUrl: String!
    primary: Boolean
    displayOrder: Int
}

type CategoryPage {
    content: [Category]
    totalPages: Int
    totalElements: Int
    number: Int
    size: Int
    first: Boolean
    last: Boolean
}

type ProductPage {
    content: [Product]
    totalPages: Int
    totalElements: Int
    number: Int
    size: Int
    first: Boolean
    last: Boolean
}

input CategoryInput {
    categoryName: String!
    icon: String
}

input ProductInput {
    name: String!
    brand: String
    price: Float!
    quantity: Int!
    description: String
    categoryId: ID
    imageName: String
}
